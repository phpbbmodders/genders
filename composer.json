{
    "name": "phpbbmodders/genders",
    "type": "phpbb-extension",
    "description": "Lets members choose a gender, shown as an icon in posts, profiles and search results.",
    "homepage": "https://www.phpbbmodders.com/",
    "version": "1.4.0-dev",
    "time": "2026-11-06",
    "keywords": [
        "phpbb",
        "extension",
        "genders",
        "communication"
    ],
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "phpBB Modders",
            "email": "board@phpbbmodders.com",
            "homepage": "https://www.phpbbmodders.com/",
            "role": "Extension Developer"
        },
        {
            "name": "Rich McGirr",
            "role": "Past Developer"
        }
    ],
    "require": {
        "php": ">=8.1.0",
        "composer/installers": "^1.0 || ^2.0"
    },
    "extra": {
        "display-name": "Genders",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.19"
        },
        "version-check": {
            "host": "www.phpbb.com",
            "directory": "/customise/db/extension/phpbb_3.1_genders",
            "filename": "version_check",
            "ssl": true
        }
    }
}
